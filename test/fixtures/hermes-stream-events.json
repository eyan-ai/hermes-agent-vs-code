{
  "thinking": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
      "sessionId": "session-redacted",
      "update": {
        "sessionUpdate": "agent_thought_chunk",
        "content": { "type": "text", "text": "Inspect the request before acting." }
      }
    }
  },
  "toolStarted": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
      "sessionId": "session-redacted",
      "update": {
        "sessionUpdate": "tool_call",
        "toolCallId": "tool-redacted",
        "title": "read: /workspace/example.txt",
        "content": [{ "type": "text", "text": "/workspace/example.txt" }]
      }
    }
  },
  "toolCompleted": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
      "sessionId": "session-redacted",
      "update": {
        "sessionUpdate": "tool_call_update",
        "toolCallId": "tool-redacted",
        "status": "completed",
        "content": [{ "type": "text", "text": "File read successfully." }]
      }
    }
  },
  "assistantText": {
    "jsonrpc": "2.0",
    "method": "session/update",
    "params": {
      "sessionId": "session-redacted",
      "update": {
        "sessionUpdate": "agent_message_chunk",
        "content": { "type": "text", "text": "Here is the result." }
      }
    }
  },
  "turnCompleted": {
    "jsonrpc": "2.0",
    "id": 4,
    "result": { "stopReason": "end_turn" }
  },
  "turnFailed": {
    "jsonrpc": "2.0",
    "id": 4,
    "error": { "code": -32603, "message": "Agent execution failed" }
  },
  "turnCancelled": {
    "jsonrpc": "2.0",
    "method": "session/cancel",
    "params": { "sessionId": "session-redacted" }
  }
}
